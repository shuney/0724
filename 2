                l.pack(side="left", padx=0, pady=0, ipadx=0, ipady=0)
                lbls.append((l, col))
            
            def on_br_enter(e):
                for l, _ in lbls: l.config(fg=VSC_YELLOW)
            def on_br_leave(e):
                for l, col in lbls: l.config(fg=col)
