SHEET_MASTER, SHEET_CAL, SHEET_MANUAL = "Resource Master", "Calendar List", "Manual"
PATH_DELIM, DEFAULT_DAY_HR_CNT = ">", 8.0

RSRC_TYPE_MAP = {
    "labor": "RT_Labor", "nonlabor": "RT_Equip", "material": "RT_Mat",
    "rt_labor": "RT_Labor", "rt_equip": "RT_Equip", "rt_mat": "RT_Mat"
}
REVERSE_TYPE_MAP = {"RT_Labor": "Labor", "RT_Equip": "NonLabor", "RT_Mat": "Material"}
MANDATORY_COLS = ["rsrc_short_name", "rsrc_name", "rsrc_type"]

def apply_pro_excel_styles(ws, is_manual=False, is_master=False, existing_count=0):
    font_name = "Segoe UI"
    font_base = Font(name=font_name, size=10)
    font_header_normal = Font(name=font_name, size=11, bold=True, color="FFFFFF")
    font_header_mandatory = Font(name=font_name, size=11, bold=True, color="FFD700") 
    font_row_header = Font(name=font_name, size=10, bold=True, color="FFFFFF")
    
    fill_header = PatternFill(start_color="2B3A55", end_color="2B3A55", fill_type="solid") 
    fill_existing_default = PatternFill(start_color="D9D9D9", end_color="D9D9D9", fill_type="solid")
    fill_existing_master = PatternFill(start_color="F3F3F3", end_color="F3F3F3", fill_type="solid")
    fill_new_olive = PatternFill(start_color="F8FAF4", end_color="F8FAF4", fill_type="solid")
    fill_new_mandatory = PatternFill(start_color="FFFDE7", end_color="FFFDE7", fill_type="solid") 
    
    light_border = Side(style='thin', color="BFBFBF")
    thick_bottom_side = Side(style='thin', color="2B3A55") 
    
    thin_border = Border(left=light_border, right=light_border, top=light_border, bottom=light_border)
    separator_border = Border(left=light_border, right=light_border, top=light_border, bottom=thick_bottom_side)
    
    wrap_alignment = Alignment(wrapText=True, vertical='center')
    center_alignment = Alignment(horizontal='center', vertical='center')

    ws.sheet_view.showGridLines = False
    if not is_manual: ws.freeze_panes = 'B2' 
    ws.row_dimensions[1].height = 26  

    col_widths = {}
    for row in ws.iter_rows():
        for cell in row:
            is_mandatory_col = any(m in str(ws.cell(1, cell.column).value) for m in MANDATORY_COLS)
            cell.border = thin_border
            
            if cell.row == 1:
                cell.fill = fill_header
                cell.font = font_header_mandatory if is_mandatory_col else font_header_normal
                if is_manual: cell.alignment = wrap_alignment
            else:
                if is_manual: 
                    cell.font = font_base
                    cell.alignment = wrap_alignment
                else:
                    if cell.row <= existing_count + 1: 
                        if is_master and cell.column == 1: 
                            cell.fill = fill_header
                            cell.font = font_row_header
                            cell.alignment = center_alignment
                        else:
                            cell.fill = fill_existing_master if is_master else fill_existing_default
                            cell.font = font_base
                        
                        if cell.row == existing_count + 1: cell.border = separator_border
                    else:
                        cell.font = font_base
                        if is_master:
                            if cell.column == 1:
                                cell.fill = fill_header
                            else:
                                cell.fill = fill_new_olive
                        else:
                            if is_mandatory_col: cell.fill = fill_new_mandatory
            
            if not is_manual and "rate_start_date" in str(ws.cell(1, cell.column).value): cell.number_format = 'YYYY-MM-DD'
            val_str = str(cell.value) if cell.value else ""
            length = sum(1.5 if ord(c) > 127 else 1.1 for c in val_str) 
            col_letter = cell.column_letter
            if length > col_widths.get(col_letter, 0): col_widths[col_letter] = length

    for col_letter, width in col_widths.items():
        if is_master and col_letter == 'A':
            ws.column_dimensions[col_letter].width = 4.5
        else:
            ws.column_dimensions[col_letter].width = 32 if is_manual else max(16, width + 5)
            
    if is_manual: 
        ws.row_dimensions[2].height = 55
        ws.row_dimensions[3].height = 55

