        del_c = ("#FFC6C4", "#FF9E9B", "#FFE0DF", "#FFB5B2", "#1D1D1F")
        t_add, t_del = "Add", "Delete"
    else:
        add_c = ("#4D4D4D", "#333333", "#DCDCAA", "#B5B58C", "#1E1E1E") # Function Yellow
        del_c = ("#4D4D4D", "#333333", "#C586C0", "#9E6B99", "#1E1E1E") # Control Purple
