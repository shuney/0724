anim_structures = {}

def animate_text_shimmer_wave(window, canvas, full_text, font_size, center_x, center_y):
    f_obj = tkfont.Font(family=C_FONT, size=font_size, weight="bold")
    char_widths = [f_obj.measure(c) for c in full_text]
    total_w = sum(char_widths)
    start_x = center_x - (total_w / 2)
    
    text_ids = []
    current_x = start_x
    for char in full_text:
        t_id = canvas.create_text(current_x, center_y, text=char, font=f_obj, anchor="w")
        text_ids.append(t_id)
        current_x += f_obj.measure(char)
        
    obj_id = f"shimmer_{id(canvas)}"
    anim_structures[obj_id] = {"phase": 0.0, "ids": text_ids}
    
    def run_shimmer_loop():
        if obj_id not in anim_structures: return
        anim_structures[obj_id]["phase"] += 0.04
        phase = anim_structures[obj_id]["phase"]
        
        for idx, t_id in enumerate(anim_structures[obj_id]["ids"]):
            char_offset = idx * 0.15
            brightness = 0.35 + 0.65 * (math.sin(phase - char_offset) + 1) / 2
            
            if THEME == "light":
                r = int(29 + (180 - 29) * (1 - brightness))
                g = int(29 + (180 - 29) * (1 - brightness))
                b = int(31 + (185 - 31) * (1 - brightness))
            else:
                r = int(86 + (197 - 86) * brightness)
                g = int(156 + (134 - 156) * brightness)
                b = int(214 + (192 - 214) * brightness)
                
            try: canvas.itemconfig(t_id, fill="#%02x%02x%02x" % (r, g, b))
            except tk.TclError: return
            
        try: window.after(40, run_shimmer_loop)
        except: pass
        
    run_shimmer_loop()

def run_button_breathing_loop(window):
    if not breathing_buttons: return
    for b in breathing_buttons:
        b["phase"] += 0.06 
        for line_id, base_r, base_g, base_b, c in b["lines"]:
            pulse = math.sin(b["phase"] - (c * 0.02))
            shift = int(12 * pulse)
            
            nr = max(0, min(255, base_r + shift))
            ng = max(0, min(255, base_g + shift))
            nb = max(0, min(255, base_b + shift))
            try:
                b["canvas"].itemconfig(line_id, fill="#%02x%02x%02x" % (nr, ng, nb))
            except tk.TclError: continue
            
    try: window.after(50, lambda: run_button_breathing_loop(window))
    except: pass

def toggle_theme(root):
    new_theme = "dark" if app_data.get("theme", "light") == "light" else "light"
    app_data["theme"] = new_theme
    try:
        app_data["win_x"] = root.winfo_x()
        app_data["win_y"] = root.winfo_y()
    except Exception:
        pass
    save_config()
    
    if getattr(sys, 'frozen', False):
        import subprocess
        subprocess.Popen([sys.executable] + sys.argv[1:], creationflags=0x00000008, close_fds=True)
    else:
        import subprocess
        subprocess.Popen([sys.executable] + sys.argv)
        
    root.quit()
    root.destroy()
    sys.exit(0)

