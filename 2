            f_browse.bind("<Leave>", on_br_leave)
            f_browse.bind("<Button-1>", on_br_click)
            for l, _ in lbls:
                l.bind("<Enter>", on_br_enter)
                l.bind("<Leave>", on_br_leave)
                l.bind("<Button-1>", on_br_click)

    if is_pwd:
