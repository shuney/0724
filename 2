def open_db_settings(root):
    set_win = tk.Toplevel(root)
    set_win.title("PRM - DB Settings")
    set_win.geometry("400x570")
    set_win.configure(bg=C_BG)
    set_win.grab_set()

    try: set_win.iconbitmap(ICON_FILE) 
    except: pass

    style = ttk.Style(set_win)
    if "clam" in style.theme_names():
        style.theme_use("clam")
        
    style.configure("Flat.TCombobox",
                    fieldbackground=C_SEC_BG,
                    background=C_BG,
                    foreground=C_FG,
                    bordercolor=C_SEC_BG, 
                    lightcolor=C_SEC_BG,
                    darkcolor=C_SEC_BG,
                    arrowcolor=C_FG,
                    padding=(2, 2))
    
    style.map("Flat.TCombobox",
              fieldbackground=[("readonly", C_SEC_BG)],
              selectbackground=[("readonly", C_SEC_BG)], 
              selectforeground=[("readonly", C_FG)])

    sub_title_canvas = tk.Canvas(set_win, width=400, height=50, bg=C_BG, highlightthickness=0)
    sub_title_canvas.pack(pady=(20, 5))
    
    animate_text_shimmer_wave(set_win, sub_title_canvas, "DB Settings", 22, 200, 25)

    frame_inputs = tk.Frame(set_win, bg=C_BG)
    frame_inputs.pack(fill="x", padx=40, pady=5)

    lbl_frame1 = tk.Frame(frame_inputs, bg=C_BG)
    lbl_frame1.pack(fill="x", pady=(0, 2), padx=0)
    tk.Label(lbl_frame1, text="▪", fg=C_ACCENT, font=("Segoe UI", 7), bg=C_BG).pack(side="left", padx=(0, 3))
    tk.Label(lbl_frame1, text="Connection Type", foreground=C_SEC_FG, font=("Segoe UI", 9, "bold"), bg=C_BG).pack(side="left", padx=0, pady=0)
    
    f_cb1_border = tk.Frame(frame_inputs, bg=C_SEC_BG, highlightbackground=C_BORDER, highlightthickness=1, height=32)
    f_cb1_border.pack_propagate(False)
    f_cb1_border.pack(fill="x", pady=(0, 10), padx=(14, 0))
    cb_type = ttk.Combobox(f_cb1_border, values=["SQL Server (Remote)", "Local File (SQLite)"], font=("Segoe UI", 10), state="readonly", style="Flat.TCombobox")
    cb_type.pack(fill="both", expand=True, padx=(4, 8), pady=3)
    
    lbl_frame2 = tk.Frame(frame_inputs, bg=C_BG)
    lbl_frame2.pack(fill="x", pady=(0, 2), padx=0)
    tk.Label(lbl_frame2, text="▪", fg=C_ACCENT, font=("Segoe UI", 7), bg=C_BG).pack(side="left", padx=(0, 3))
    tk.Label(lbl_frame2, text="Select or Type Profile Name", bg=C_BG, fg=C_SEC_FG, font=("Segoe UI", 9, "bold")).pack(side="left", padx=0, pady=0)
    
    frame_prof_ctrl = tk.Frame(frame_inputs, bg=C_BG)
    frame_prof_ctrl.pack(fill="x", pady=(0, 10), padx=(14, 0))

    cvs_ctrl = tk.Canvas(frame_prof_ctrl, width=130, height=32, bg=C_BG, highlightthickness=0)
    cvs_ctrl.pack(side="right", padx=(5, 0))

    f_cb2_border = tk.Frame(frame_prof_ctrl, bg=C_SEC_BG, highlightbackground=C_BORDER, highlightthickness=1, height=32)
    f_cb2_border.pack_propagate(False)
    f_cb2_border.pack(side="left", fill="x", expand=True)
    cb_profile = ttk.Combobox(f_cb2_border, font=("Segoe UI", 10), state="normal", style="Flat.TCombobox")
    cb_profile.pack(fill="both", expand=True, padx=(4, 8), pady=3)

    fields = {}
    
    # [수정] 유저가 기존 셋업을 수정 중인지, 신규 추가 중인지 기억하는 상태 변수
    ui_state = {"loaded_profile": None} 

    def browse_sqlite_file(target_entry):
        f_path = filedialog.askopenfilename(title="Select Local Database File", filetypes=[("SQLite Files", "*.db;*.sqlite;*.sqlite3"), ("All Files", "*.*")], parent=set_win)
        if f_path:
            target_entry.delete(0, tk.END)
            target_entry.insert(0, f_path)

    def refresh_ui_fields():
        db_type = cb_type.get()
        for k in ["HOST", "NAME", "USER", "PASS"]:
            if k in fields: fields[k]["frame"].pack_forget()
            
        if db_type == "Local File (SQLite)":
            fields["HOST"]["frame"].pack(fill="x", pady=4)
            lbl_container = fields["HOST"]["frame"].winfo_children()[0]
            lbl_container.winfo_children()[1].config(text="Database File Path")
            fields["HOST"]["frame"].winfo_children()[1].winfo_children()[1].pack(side="right", padx=10)
        else:
            for k in ["HOST", "NAME", "USER", "PASS"]:
                fields[k]["frame"].pack(fill="x", pady=4)
            lbl_container = fields["HOST"]["frame"].winfo_children()[0]
            lbl_container.winfo_children()[1].config(text="Database Host")
            fields["HOST"]["frame"].winfo_children()[1].winfo_children()[1].pack_forget()

    f_host, ent_host = create_modern_round_field(frame_inputs, "Database Host", with_browse=browse_sqlite_file, tooltip="e.g., IP_Address\\SQLEXPRESS or sqlite.db path")
    f_name, ent_name = create_modern_round_field(frame_inputs, "Database Name")
    f_user, ent_user = create_modern_round_field(frame_inputs, "Username")
    f_pwd, ent_pwd = create_modern_round_field(frame_inputs, "Password", is_pwd=True)

    fields["HOST"] = {"frame": f_host, "entry": ent_host}
    fields["NAME"] = {"frame": f_name, "entry": ent_name}
    fields["USER"] = {"frame": f_user, "entry": ent_user}
    fields["PASS"] = {"frame": f_pwd, "entry": ent_pwd}

    def clear_inputs(clear_profile_name=True):
        if clear_profile_name:
            cb_profile.set("")
        for k in fields:
            fields[k]["entry"].delete(0, tk.END)

    def load_selected_profile(event=None):
        prof_name = cb_profile.get()
        if not prof_name: return
        ui_state["loaded_profile"] = prof_name # 현재 불러온 프로파일 이름 기억
        data = app_data["profiles"].get(prof_name, {})
        clear_inputs(clear_profile_name=False)
        for k, key in [("HOST", "HOST"), ("NAME", "NAME"), ("USER", "USER"), ("PASS", "PASS")]:
            fields[k]["entry"].insert(0, data.get(key, ""))
        refresh_ui_fields()

    def update_profile_list(*args):
        current_type = cb_type.get()
        valid_profiles = [p for p, data in app_data["profiles"].items() if data.get("TYPE", "SQL Server (Remote)") == current_type]
        cb_profile['values'] = valid_profiles
        
        if valid_profiles:
            if app_data["current_profile"] in valid_profiles:
                cb_profile.set(app_data["current_profile"])
            else:
                cb_profile.set(valid_profiles[0])
            load_selected_profile()
        else:
            clear_inputs()
            ui_state["loaded_profile"] = None
            refresh_ui_fields()

    cb_type.bind("<<ComboboxSelected>>", update_profile_list)
    cb_profile.bind("<<ComboboxSelected>>", load_selected_profile)

    # [수정] Add 버튼 클릭 시 빈칸으로 싹 밀어버림 (Save를 누를 때 신규로 저장됨)
    def on_add():
        clear_inputs(clear_profile_name=True)
        ui_state["loaded_profile"] = None # 새로 만드는 상태로 전환
        refresh_ui_fields()

    def on_delete():
        prof = cb_profile.get().strip()
        if not prof: return
        if prof == "Default": return messagebox.showwarning("Warning", "The Default profile cannot be deleted.", parent=set_win)
        if messagebox.askyesno("Delete", f"Are you sure you want to delete profile '{prof}'?", parent=set_win):
            del app_data["profiles"][prof]
            if app_data["current_profile"] == prof: app_data["current_profile"] = "Default"
            save_config(); update_profile_list()
    

    if THEME == "light":
        # [수정] 라이트 모드도 5개의 색상(기본 상/하, 호버 상/하, 글자색)을 모두 부여하여 증발 버그 완벽 해결
        add_c = ("#D0E8FF", "#A1D1FF", "#E6F2FF", "#B8DCFF", "#1D1D1F")
        del_c = ("#FFC6C4", "#FF9E9B", "#FFE0DF", "#FFB5B2", "#1D1D1F")
    else:
        add_c = ("#757578", "#48484A", "#98989D", "#5C5C5E", "#FFFFFF")
        del_c = ("#636366", "#3A3A3C", "#86868B", "#48484A", "#FFFFFF")
        
    create_diagonal_gradient_pill(cvs_ctrl, 5, 2, 60, 26, 3, add_c[0], add_c[1], add_c[2], add_c[3], "Add", add_c[4], on_add, f_weight="normal")
    create_diagonal_gradient_pill(cvs_ctrl, 70, 2, 60, 26, 3, del_c[0], del_c[1], del_c[2], del_c[3], "Delete", del_c[4], on_delete, f_size=8, f_weight="normal")

    initial_type = app_data["profiles"].get(app_data["current_profile"], {}).get("TYPE", "SQL Server (Remote)")
    cb_type.set(initial_type)
    update_profile_list()

    def test_connection():
        if not cb_profile.get(): return messagebox.showwarning("Warning", "Please select or type a profile first.", parent=set_win)
        
        db_host_val = str(ent_host.get()).replace('\\\\', '\\')
        
        if cb_type.get() == "Local File (SQLite)":
            try:
                engine = create_engine(f"sqlite:///{db_host_val}")
                with engine.connect() as conn: conn.execute(text("SELECT 1"))
                messagebox.showinfo("Success", "Local SQLite connection verified successfully.", parent=set_win)
                return
            except Exception as e:
                messagebox.showerror("Failed", f"SQLite target verification failed:\n{e}", parent=set_win); return

        conn_str = f"mssql+pymssql://{ent_user.get()}:{ent_pwd.get()}@{db_host_val}/{ent_name.get()}"
        try:
            engine = create_engine(conn_str, connect_args={'login_timeout': 3})
            with engine.connect() as conn: conn.execute(text("SELECT 1"))
            messagebox.showinfo("Success", "Database connection successful.", parent=set_win)
        except Exception:
            messagebox.showerror("Failed", "Connection failed. Please verify your credentials.", parent=set_win)

    def on_save():
        prof_name = cb_profile.get().strip()
        if not prof_name: return messagebox.showwarning("Warning", "Profile name cannot be empty.", parent=set_win)
        
        loaded_name = ui_state["loaded_profile"]
        
        # [수정] 1. 기존 프로파일의 이름을 변경(Rename)하는 경우
        if loaded_name and loaded_name != prof_name:
            if prof_name in app_data["profiles"]:
                return messagebox.showwarning("Warning", f"Profile '{prof_name}' already exists.", parent=set_win)
            if loaded_name == "Default":
                return messagebox.showwarning("Warning", "The Default profile cannot be renamed.", parent=set_win)
            
            # 기존 데이터를 새 이름으로 복사하고 기존 키 삭제 (Rename 동작)
            app_data["profiles"][prof_name] = app_data["profiles"].pop(loaded_name)
        
        # [수정] 2. 아예 새로운 프로파일을 저장(Add New)하거나 내용만 업데이트하는 경우
        elif not loaded_name and prof_name in app_data["profiles"]:
            if not messagebox.askyesno("Overwrite", f"Profile '{prof_name}' already exists. Do you want to overwrite it?", parent=set_win):
                return

        app_data["current_profile"] = prof_name
        app_data["profiles"][prof_name] = {
            "TYPE": cb_type.get(),
            "HOST": ent_host.get(), "NAME": ent_name.get(), "USER": ent_user.get(), "PASS": ent_pwd.get()
        }
        save_config()
        messagebox.showinfo("Saved", f"Profile '{prof_name}' saved and applied successfully.", parent=set_win)
        set_win.destroy()

    frame_btns = tk.Frame(set_win, bg=C_BG)
    frame_btns.pack(pady=5)
    lbl_test = tk.Label(frame_btns, text="🔗 Test Connection", font=("Segoe UI", 9, "bold"), fg=C_ACCENT, bg=C_BG, cursor="hand2")
    lbl_test.pack(pady=4)
    lbl_test.bind("<Enter>", lambda e: lbl_test.config(fg=C_ACCENT_HOVER))
    lbl_test.bind("<Leave>", lambda e: lbl_test.config(fg=C_ACCENT))
    lbl_test.bind("<Button-1>", lambda e: test_connection())

    canvas_save = tk.Canvas(frame_btns, width=340, height=65, bg=C_BG, highlightthickness=0)
    canvas_save.pack()
    
    if THEME == "light":
        c_save = ("#5E5CE6", "#4B49B7", "#7D7AFF", "#5A58D6")
    else:
        # [수정] Save 버튼 톤업 (더 메탈릭하고 밝게)
        c_save = ("#6C6C70", "#48484A", "#8E8E93", "#5C5C5E")
        
    create_diagonal_gradient_button(canvas_save, 50, 10, 240, 45, 10, c_save[0], c_save[1], c_save[2], c_save[3], "Save & Apply Profile", on_save)

