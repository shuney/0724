        c_save = ("#5E5CE6", "#4B49B7", "#7D7AFF", "#5A58D6")
        t_save = "Save & Apply Profile"
    else:
        # String Orange (#CE9178)
        c_save = ("#855C4A", "#4A3329", "#CE9178", "#855C4A")
        t_save = "await db.commit()"
        
    create_diagonal_gradient_button(canvas_save, 50, 10, 240, 45, 10, c_save[0], c_save[1], c_save[2], c_save[3], t_save, on_save, f_size=11 if THEME == "light" else 10)


