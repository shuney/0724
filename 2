def create_multicolor_label_button(parent_widget, parts, command, relx=None, rely=None, anchor=None, pack_side=None, pady=0, font_size=9, f_weight="normal"):
    f_wrapper = tk.Frame(parent_widget, bg=C_BG, cursor="hand2")
    if pack_side:
        f_wrapper.pack(side=pack_side, pady=pady)
    else:
        f_wrapper.place(relx=relx, rely=rely, anchor=anchor)
    
    lbls = []
    for text, color in parts:
        # [수정] tk.Label 기본 여백(Padding/Border) 모두 0으로 설정하여 완벽한 밀착 구현
        l = tk.Label(f_wrapper, text=text, font=(C_FONT, font_size, f_weight), bg=C_BG, fg=color, bd=0, padx=0, pady=0, highlightthickness=0)
        l.pack(side="left", padx=0, pady=0, ipadx=0, ipady=0)
        lbls.append((l, color))

    def on_enter(e):
        for l, _ in lbls: l.config(fg=C_ACCENT_HOVER if THEME == "light" else VSC_YELLOW)
    def on_leave(e):
        for l, color in lbls: l.config(fg=color)
    def on_click(e):
        command()

    f_wrapper.bind("<Enter>", on_enter)
    f_wrapper.bind("<Leave>", on_leave)
    f_wrapper.bind("<Button-1>", on_click)
    
    for l, _ in lbls:
        l.bind("<Enter>", on_enter)
        l.bind("<Leave>", on_leave)
        l.bind("<Button-1>", on_click)


