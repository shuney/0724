anim_structures = {}

def animate_text_shimmer_wave(window, canvas, full_text, font_size, center_x, center_y):
    f_obj = tkfont.Font(family="Segoe UI", size=font_size, weight="bold")
    char_widths = [f_obj.measure(c) for c in full_text]
    total_w = sum(char_widths)
    start_x = center_x - (total_w / 2)
    
    text_ids = []
    current_x = start_x
    for char in full_text:
        t_id = canvas.create_text(current_x, center_y, text=char, font=f_obj, anchor="w")
        text_ids.append(t_id)
        current_x += f_obj.measure(char)
        
    obj_id = f"shimmer_{id(canvas)}"
    anim_structures[obj_id] = {"phase": 0.0, "ids": text_ids}
    
    def run_shimmer_loop():
        if obj_id not in anim_structures: return
        anim_structures[obj_id]["phase"] += 0.04
        phase = anim_structures[obj_id]["phase"]
        
        for idx, t_id in enumerate(anim_structures[obj_id]["ids"]):
            char_offset = idx * 0.15
            brightness = 0.35 + 0.65 * (math.sin(phase - char_offset) + 1) / 2
            
            if THEME == "light":
                r = int(29 + (180 - 29) * (1 - brightness))
                g = int(29 + (180 - 29) * (1 - brightness))
                b = int(31 + (185 - 31) * (1 - brightness))
            else:
                # [수정] 모노톤 컨셉: 중간 회색에서 순백색으로 차갑게 빛나는 실버 메탈릭 펄스
                val = int(120 + (255 - 120) * brightness)
                r = g = b = val
                
            try: canvas.itemconfig(t_id, fill="#%02x%02x%02x" % (r, g, b))
            except tk.TclError: return
            
        try: window.after(40, run_shimmer_loop)
        except: pass
        
    run_shimmer_loop()

def run_button_breathing_loop(window):
    if not breathing_buttons: return
    for b in breathing_buttons:
        b["phase"] += 0.06 
        for line_id, base_r, base_g, base_b, c in b["lines"]:
            pulse = math.sin(b["phase"] - (c * 0.02))
            shift = int(12 * pulse)
            
            nr = max(0, min(255, base_r + shift))
            ng = max(0, min(255, base_g + shift))
            nb = max(0, min(255, base_b + shift))
            try:
                b["canvas"].itemconfig(line_id, fill="#%02x%02x%02x" % (nr, ng, nb))
            except tk.TclError: continue
            
    try: window.after(50, lambda: run_button_breathing_loop(window))
    except: pass

# [수정] 테마 변경 시 듀얼모니터 크래시 방지를 위해 try-except로 좌표 획득 감싸기
# [수정] 테마 변경(재실행) 시 Tcl/Tk 폴더 꼬임 방지 로직 추가
def toggle_theme(root):
    new_theme = "dark" if app_data.get("theme", "light") == "light" else "light"
    app_data["theme"] = new_theme
    try:
        app_data["win_x"] = root.winfo_x()
        app_data["win_y"] = root.winfo_y()
    except Exception:
        pass
    save_config()
    
    # ========================================================
    # [핵심 패치] 환경 변수 상속 없이 완전한 독립 실행 (더블 클릭과 동일한 효과)
    if getattr(sys, 'frozen', False):
        # exe로 구운 경우: 윈도우 쉘을 통해 깨끗하게 새 프로세스 실행
        os.startfile(sys.executable)
    else:
        # VS Code 등 파이썬 환경에서 실행 중인 경우
        import subprocess
        subprocess.Popen([sys.executable] + sys.argv)
        
    root.destroy()
    os._exit(0) # 구버전 프로그램이 즉시 강제 종료되도록 하여 폴더 충돌 원천 차단
    # ========================================================
def main():
    root = tk.Tk()
    root.title("PRM - Primavera P6 Resource Manager")

    window_width, window_height = 460, 340
    sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
    
    default_x = int((sw/2) - (window_width/2))
    default_y = int((sh/2) - (window_height/2))
    
    x_pos = app_data.get("win_x")
    y_pos = app_data.get("win_y")
    
    # [수정] 듀얼모니터 음수 좌표(-1920 등)를 튕겨내던 오류 덩어리 경계선 체크 로직 완전히 삭제
    # 좌표값이 아예 없을 때만 정중앙 띄우기 적용
    if x_pos is None or y_pos is None:
        x_pos, y_pos = default_x, default_y
        
    root.geometry(f"{window_width}x{window_height}+{x_pos}+{y_pos}")
    
    root.configure(bg=C_BG)
    
    try: 
        root.iconbitmap(ICON_FILE) 
    except: 
        pass
    
    title_canvas = tk.Canvas(root, width=460, height=65, bg=C_BG, highlightthickness=0)
    title_canvas.pack(pady=(25, 2))
    
    animate_text_shimmer_wave(root, title_canvas, "Resource Manager", 26, 230, 30)
    
    tk.Label(root, text="Excel ↔ P6 Database Sync Tool", font=("Segoe UI", 11), bg=C_BG, fg=C_SUBTITLE_FG).pack(pady=(0, 20))

    canvas_main = tk.Canvas(root, width=460, height=150, bg=C_BG, highlightthickness=0)
    canvas_main.pack()

    if THEME == "light":
        c_export = ("#47A1FF", "#0071E3", "#66B2FF", "#1A82F0")
        c_import = ("#3EE068", "#34C759", "#5CF282", "#41D868")
    else:
        # Export 메인: 묵직한 플래티넘 실버
        c_export = ("#8E8E93", "#636366", "#A1A1A6", "#757578") 
        # Import 메인: 차분한 스틸 그레이
        c_import = ("#5C5C5E", "#3A3A3C", "#757578", "#48484A") 

    # [수정] x시작점을 130으로 땡기고, 폭(w)을 200으로 줄여 허전함 해결 (완벽한 중앙 정렬)
    create_diagonal_gradient_button(canvas_main, 120, 10, 220, 45, 10, c_export[0], c_export[1], c_export[2], c_export[3], "Export Template", export_template)
    create_diagonal_gradient_button(canvas_main, 120, 75, 220, 45, 10, c_import[0], c_import[1], c_import[2], c_import[3], "Import to DB", lambda: import_data(root))
    btn_settings = tk.Label(root, text="DB Settings", font=("Segoe UI", 10, "bold"), bg=C_BG, fg=C_THEME_FG, cursor="hand2")
    btn_settings.place(relx=0.04, rely=0.96, anchor="sw")
    btn_settings.bind("<Enter>", lambda e: btn_settings.config(fg=C_ACCENT_HOVER)) 
    btn_settings.bind("<Leave>", lambda e: btn_settings.config(fg=C_THEME_FG))
    btn_settings.bind("<Button-1>", lambda e: open_db_settings(root))

    theme_text = "Dark Mode" if THEME == "light" else "Light Mode"
    btn_theme = tk.Label(root, text=theme_text, font=("Segoe UI", 10, "bold"), bg=C_BG, fg=C_THEME_FG, cursor="hand2")
    btn_theme.place(relx=0.96, rely=0.96, anchor="se")
    btn_theme.bind("<Enter>", lambda e: btn_theme.config(fg=C_ACCENT_HOVER))
    btn_theme.bind("<Leave>", lambda e: btn_theme.config(fg=C_THEME_FG))
    btn_theme.bind("<Button-1>", lambda e: toggle_theme(root))

    tk.Label(root, text="v1.0.0 1st Edition", font=("Segoe UI", 8), bg=C_BG, fg="#A1A1A6").place(relx=0.5, rely=0.96, anchor="s")

    run_button_breathing_loop(root)

    root.mainloop()

if __name__ == "__main__":
    main()
