# [수정] VS Code 신택스 하이라이팅을 지원하는 필드 생성 엔진
def create_modern_round_field(parent_frame, label_text, dark_syntax_parts=None, is_pwd=False, with_browse=None, tooltip=None):
    f_container = tk.Frame(parent_frame, bg=C_BG)
    f_container.pack(fill="x", pady=4)
    
    lbl_frame = tk.Frame(f_container, bg=C_BG)
    lbl_frame.pack(fill="x", pady=(0, 2))
    
    tk.Label(lbl_frame, text="▪", fg=C_ACCENT, font=(C_FONT, 7), bg=C_BG).pack(side="left", padx=(0, 3))
    
    # [하이라이팅] 라이트 모드는 단일 문자열, 다크 모드는 역할별로 쪼개진 파스텔톤 다중 렌더링
    if THEME == "light" or not dark_syntax_parts:
        tk.Label(lbl_frame, text=label_text, foreground=C_SEC_FG, font=(C_FONT, 9, "bold"), bg=C_BG).pack(side="left", padx=0, pady=0)
    else:
        for txt, color in dark_syntax_parts:
            tk.Label(lbl_frame, text=txt, foreground=color, font=(C_FONT, 9, "normal"), bg=C_BG).pack(side="left", padx=0, pady=0)
    
    f_border = tk.Frame(f_container, bg=C_SEC_BG, highlightbackground=C_BORDER, highlightthickness=1, height=32)
    f_border.pack_propagate(False)
    f_border.pack(fill="x", padx=(14, 0))
    
    ent = tk.Entry(f_border, font=(C_FONT, 10), bd=0, highlightthickness=0, bg=C_SEC_BG, fg=C_FG, insertbackground=C_FG)
    ent.pack(side="left", fill="both", expand=True, padx=(10, 8))
    
    if tooltip: ToolTip(ent, tooltip)

    if with_browse:
        btn_text = "Browse..." if THEME == "light" else "os.path.find()"
        btn_fg = C_ACCENT if THEME == "light" else VSC_YELLOW
        btn_browse = tk.Label(f_border, text=btn_text, font=(C_FONT, 9, "bold" if THEME == "light" else "normal"), fg=btn_fg, bg=C_SEC_BG, cursor="hand2")
        btn_browse.pack(side="right", padx=10)
        btn_browse.bind("<Button-1>", lambda e: with_browse(ent))

    if is_pwd:
        ent.config(show="*")
        sh_txt = "Show" if THEME == "light" else "[ show ]"
        hd_txt = "Hide" if THEME == "light" else "[ hide ]"
        pwd_fg = C_ACCENT if THEME == "light" else VSC_GREEN
        
        lbl_toggle = tk.Label(f_border, text=sh_txt, font=(C_FONT, 8, "bold" if THEME == "light" else "normal"), fg=pwd_fg, bg=C_SEC_BG, cursor="hand2")
        lbl_toggle.pack(side="right", padx=10)
        
        def toggle_pwd_view(e):
            if ent.cget("show") == "*":
                ent.config(show=""); lbl_toggle.config(text=hd_txt)
            else:
                ent.config(show="*"); lbl_toggle.config(text=sh_txt)
        lbl_toggle.bind("<Button-1>", toggle_pwd_view)
        
    return f_container, ent
